---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="未找到" description="这个页面不存在，或已经下线。">
  <section aria-labelledby="error-title">
    <p class="mb-3 font-mono text-[13px] text-mute">404</p>
    <h1 id="error-title" class="mb-4 font-semibold text-2xl tracking-[-0.02em]">
      这个页面不存在，或已经下线。
    </h1>
    <a class="underline decoration-mute underline-offset-[3px] hover:decoration-fg" href="/">回到首页</a>
  </section>
</BaseLayout>
