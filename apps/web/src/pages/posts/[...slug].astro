---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import 'katex/dist/katex.min.css'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft)

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

type Props = {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const { Content, headings } = await render(post)
// Sections and their subsections; the appendix is reference material, so only its title is listed.
const outline = headings
  .filter(({ depth }) => depth === 2 || depth === 3)
  .filter((heading, index, list) => {
    if (heading.depth === 2) return true
    const parent = list.slice(0, index).findLast(({ depth }) => depth === 2)
    return !parent?.text.startsWith('附录')
  })
const publishedTime = post.data.date.toISOString()
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  ogType="article"
  publishedTime={publishedTime}
  tags={post.data.tags}
>
  <article data-source-file={post.filePath}>
    <header class="mb-10">
      <p class="mb-3 font-mono text-[13px] text-mute">
        <time datetime={publishedTime}>{publishedTime.slice(0, 10)}</time>
        {post.data.tags.length > 0 && <span> · {post.data.tags.join(' · ')}</span>}
      </p>
      <h1 class="font-semibold text-[28px] leading-[1.3] tracking-[-0.02em]">
        {post.data.title}
      </h1>
      <p class="mt-4 text-mute">{post.data.summary}</p>
      {
        outline.length > 0 && (
          <details class="mt-8 border-hair border-y py-3 text-[14px] min-[1440px]:hidden">
            <summary class="cursor-pointer text-mute hover:text-fg">目录</summary>
            <nav aria-label="文章目录">
              <ol class="mt-3 space-y-1.5">
                {outline.map((heading) => (
                  <li class:list={{ 'pl-4': heading.depth === 3 }}>
                    <a class="text-mute hover:text-fg" href={`#${heading.slug}`}>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </details>
        )
      }
    </header>
    {
      outline.length > 0 && (
        <nav
          class="fixed top-24 left-[calc(50%-712px)] hidden max-h-[calc(100vh-8rem)] w-[200px] overflow-y-auto text-[13px] leading-[1.5] min-[1440px]:block"
          aria-label="文章目录"
          data-toc
        >
          <p class="mb-3 text-mute">目录</p>
          <ol class="space-y-2 border-hair border-l">
            {outline.map((heading) => (
              <li>
                <a
                  class:list={[
                    '-ml-px block border-transparent border-l text-mute transition-colors hover:text-fg aria-[current]:border-fg aria-[current]:text-fg',
                    heading.depth === 3 ? 'pl-6' : 'pl-3',
                  ]}
                  href={`#${heading.slug}`}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="prose-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<script>
  // Side outline on wide screens: mark the section the reader is in.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')]
  const headings = [...document.querySelectorAll<HTMLElement>('.prose-body :is(h2, h3)[id]')]

  const markCurrent = () => {
    const current = headings.filter((heading) => heading.getBoundingClientRect().top < 120).at(-1)
    links.forEach((link) => {
      const active = current !== undefined && decodeURIComponent(link.hash.slice(1)) === current.id
      if (active) link.setAttribute('aria-current', 'location')
      else link.removeAttribute('aria-current')
    })
  }

  if (links.length > 0) {
    window.addEventListener('scroll', markCurrent, { passive: true })
    markCurrent()
  }
</script>
