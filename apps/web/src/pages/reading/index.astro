---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { books, bookOfEntry, slugInBook, titleFromBody } from '../../lib/books'

const all = await getCollection('reading')

const fmt = (d: Date) => d.toISOString().slice(0, 10)
const orderOf = (order: number | undefined) => order ?? Number.MAX_SAFE_INTEGER

const groupedBooks = books.map((book) => {
  const articles = all
    .filter((entry) => bookOfEntry(entry.id)?.id === book.id)
    .map((entry) => {
      const slug = slugInBook(entry.id, book)
      return {
        slug,
        title: entry.data.title ?? titleFromBody(entry.body, slug),
        date: entry.data.date,
        order: orderOf(entry.data.order as number | undefined),
      }
    })
    .sort((a, b) => a.order - b.order)
  return { book, articles }
})

const hasAny = groupedBooks.some((g) => g.articles.length > 0)
---

<BaseLayout title="Reading" description="读书笔记">
  <article>
    <h1>Reading</h1>
    {hasAny ? (
      groupedBooks.map(({ book, articles }) =>
        articles.length === 0 ? null : (
          <section class="book-section">
            <h2 class="book-title">
              <a href={`/reading/${book.id}`}>{book.title}</a>
            </h2>
            {book.subtitle && <p class="chapter-meta">{book.subtitle}</p>}
            <ul class="chapter-list">
              {articles.map((article) => (
                <li class="chapter-row">
                  <a class="title" href={`/reading/${book.id}/${article.slug}`}>
                    {article.title}
                  </a>
                  <span class="dots" aria-hidden="true" />
                  {article.date && (
                    <time class="right" datetime={article.date.toISOString()}>
                      {fmt(article.date)}
                    </time>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ),
      )
    ) : (
      <p class="empty">nothing yet</p>
    )}
  </article>
</BaseLayout>

<style>
  .book-section + .book-section {
    margin-top: 2rem;
  }
  .book-title {
    margin-bottom: 0.25rem;
  }
  .book-title a {
    text-decoration: none;
    color: inherit;
  }
  .book-title a:hover {
    text-decoration: underline;
  }
</style>
