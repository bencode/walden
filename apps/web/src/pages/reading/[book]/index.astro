---
import { getCollection } from 'astro:content'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { books, getBook, slugInBook, titleFromBody } from '../../../lib/books'

export async function getStaticPaths() {
  return books.map((book) => ({ params: { book: book.id } }))
}

const { book: bookId } = Astro.params
const book = getBook(bookId!)
if (!book) throw new Error(`unknown book: ${bookId}`)

const fmt = (d: Date) => d.toISOString().slice(0, 10)
const orderOf = (order: number | undefined) => order ?? Number.MAX_SAFE_INTEGER

const all = await getCollection('reading')
const articles = all
  .filter((entry) => entry.id.startsWith(`${book.dirPrefix}/`))
  .map((entry) => {
    const slug = slugInBook(entry.id, book)
    return {
      slug,
      title: entry.data.title ?? titleFromBody(entry.body, slug),
      date: entry.data.date,
      order: orderOf(entry.data.order as number | undefined),
    }
  })
  .sort((a, b) => a.order - b.order)
---

<BaseLayout title={book.title} description={book.subtitle}>
  <article>
    <p class="breadcrumb">
      <a href="/reading">reading</a>
      <span class="sep">·</span>
      {book.id}
    </p>
    <h1>{book.title}</h1>
    {book.subtitle && <p class="chapter-meta">{book.subtitle}</p>}

    {
      articles.length === 0 ? (
        <p class="empty">nothing yet</p>
      ) : (
        <ul class="chapter-list">
          {articles.map((article) => (
            <li class="chapter-row">
              <a class="title" href={`/reading/${book.id}/${article.slug}`}>
                {article.title}
              </a>
              <span class="dots" aria-hidden="true" />
              {article.date && (
                <time class="right" datetime={article.date.toISOString()}>
                  {fmt(article.date)}
                </time>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </article>
</BaseLayout>
