---
import '@fontsource-variable/recursive/full.css'
import '../styles/global.css'
import ReviewLayer from '../components/ReviewLayer.astro'

type Props = {
  title: string
  description?: string
  showChrome?: boolean
}

const {
  title,
  description = 'Qijun 的个人实验室：工具、实验与阶段性笔记。',
  showChrome = true,
} = Astro.props
const siteName = 'LambdaCraft'
const fullTitle = title === siteName ? title : `${title} · ${siteName}`
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url
const isDev = import.meta.env.DEV

const navItems: ReadonlyArray<{ href: string; label: string }> = [
  { href: '/#now', label: '现在' },
  { href: '/#lab', label: '实验' },
  { href: '/#notes', label: '笔记' },
]
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f7f7" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body>
    {
      showChrome ? (
        <>
          <a class="skip-link" href="#main-content">
            跳到正文
          </a>

          <div class="site-shell">
            <header class="site-header">
              <a class="wordmark" href="/" aria-label="LambdaCraft 首页">
                <svg viewBox="0 0 32 32" aria-hidden="true">
                  <path d="M8 5c4.6 0 6.2 5.2 8.1 10.2L21 28" />
                  <path d="m16.1 15.2-6.6 12.6" />
                </svg>
                <span>LambdaCraft</span>
              </a>

              <nav class="site-nav" aria-label="主导航">
                {navItems.map((item) => (
                  <a href={item.href}>{item.label}</a>
                ))}
                <a
                  class="external-link"
                  href="https://github.com/bencode"
                  aria-label="在 GitHub 查看 bencode"
                >
                  GitHub <span aria-hidden="true">↗</span>
                </a>
              </nav>
            </header>

            <main id="main-content">
              <slot />
            </main>

            <footer class="site-footer">
              <span>LambdaCraft / qijun.io</span>
              <span>© {new Date().getFullYear()} Qijun</span>
            </footer>
          </div>
        </>
      ) : (
        <main id="main-content">
          <slot />
        </main>
      )
    }

    {isDev && showChrome && <ReviewLayer />}
  </body>
</html>
