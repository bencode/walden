---
import '@fontsource-variable/geist'
import '@fontsource-variable/geist-mono'
import '../styles/global.css'
import Repl from '../components/Repl.astro'
import ReviewLayer from '../components/ReviewLayer.astro'
import { siteDescription, siteName } from '../site'

type Props = {
  title: string
  description?: string
  showChrome?: boolean
  ogType?: 'website' | 'article'
  publishedTime?: string
  tags?: ReadonlyArray<string>
}

const {
  title,
  description = siteDescription,
  showChrome = true,
  ogType = 'website',
  publishedTime,
  tags = [],
} = Astro.props
const fullTitle = title === siteName ? title : `${title} · ${siteName}`
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url
const isDev = import.meta.env.DEV
const currentPath = Astro.url.pathname

const navItems: ReadonlyArray<{ href: string; label: string }> = [
  { href: '/posts', label: '文章' },
  { href: 'https://github.com/bencode', label: 'GitHub' },
]
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Qijun" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta property="og:image" content={new URL('/og.png', Astro.site ?? Astro.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen bg-bg font-sans text-[16px] text-fg leading-[1.7] antialiased">
    {
      showChrome ? (
        <>
          <a
            class="sr-only z-50 rounded bg-bg px-3 py-2 underline focus:fixed focus:top-4 focus:left-4 focus:not-sr-only"
            href="#main-content"
          >
            跳到正文
          </a>
          <div class="mx-auto flex min-h-screen w-full max-w-[680px] flex-col px-6 pt-16 pb-20 sm:pt-24">
            <header class="mb-14 flex flex-wrap items-center justify-between gap-x-4">
              <Repl />
              <nav class="flex gap-1 text-[14px]" aria-label="主导航">
                {navItems.map((item) => {
                  const current = currentPath.startsWith(item.href)
                  return (
                    <a
                      class:list={[
                        'rounded-md px-2.5 py-1.5 transition-colors hover:bg-hover hover:text-fg',
                        current ? 'bg-hover text-fg' : 'text-mute',
                      ]}
                      href={item.href}
                      aria-current={current ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  )
                })}
              </nav>
            </header>
            <main id="main-content" class="flex-1">
              <slot />
            </main>
            <footer class="mt-16 text-[13px] text-mute">© {new Date().getFullYear()} qijun.io</footer>
          </div>
        </>
      ) : (
        <main id="main-content">
          <slot />
        </main>
      )
    }

    {isDev && showChrome && <ReviewLayer />}
    <script>
      const renderMermaidDiagrams = async () => {
        const diagrams = document.querySelectorAll<HTMLElement>('.mermaid')
        if (diagrams.length === 0) return

        const { default: mermaid } = await import('mermaid')
        const dark = window.matchMedia('(prefers-color-scheme: dark)').matches
        mermaid.initialize({
          startOnLoad: false,
          theme: dark ? 'dark' : 'neutral',
          securityLevel: 'strict',
          fontFamily: getComputedStyle(document.body).fontFamily,
          flowchart: { wrappingWidth: 260 },
          // Flat nodes: the neo look draws a drop shadow unless the theme turns it off.
          themeVariables: { dropShadow: 'none' },
        })
        await mermaid.run({ nodes: [...diagrams] })
      }

      void renderMermaidDiagrams().catch((error: unknown) => {
        console.error('Mermaid 图表渲染失败', error)
      })
    </script>
  </body>
</html>
