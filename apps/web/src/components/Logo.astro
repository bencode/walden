---
// 终端里的 ASCII 鱼 ><(((º>，鱼眼换成 λ：网名大鱼，括号同时是 Lisp 的括号。
---

<span class="logo font-mono font-semibold" aria-hidden="true"
  ><span class="swim"><span class="text-mute">&gt;&lt;<span class="gills">(((</span></span>λ&gt;</span></span
>

<style>
  .logo {
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .gills {
    letter-spacing: -0.22em;
    margin-right: 0.18em;
  }
  .swim {
    display: inline-block;
    transition: transform 0.4s ease-out;
  }
  :global(a:hover) > .logo .swim {
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .swim {
      transition: none;
    }
  }
</style>
