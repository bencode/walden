---
import type { Lang } from './runtime/common/types'

interface Props {
  lang: Lang
  code: string
  cellId?: string
  hint?: string
}

const {
  lang,
  code,
  cellId = `cell-${Math.random().toString(36).slice(2, 10)}`,
  hint,
} = Astro.props
---

<div
  class="coderunner-cell"
  data-cell-id={cellId}
  data-lang={lang}
  data-initial-code={code.replace(/^\n+|\n+$/g, '')}
>
  {hint && <div class="cell-hint">{hint}</div>}
  <div class="editor-wrap">
    <div class="editor-container"></div>
    <div class="cell-footer">
      <span class="cell-status" data-state="idle">Ctrl + Enter</span>
    </div>
  </div>
  <div class="output-container hidden"></div>
</div>

<script>
  import { initAllCells } from './runtime/common/cell-controller'

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllCells)
  } else {
    initAllCells()
  }
</script>

<style is:global>
  /* Colours follow the site tokens in global.css, so cells switch with dark mode. */
  .coderunner-cell {
    --syn-keyword: #cf222e;
    --syn-string: #0a3069;
    --syn-number: #0550ae;
    --syn-comment: #6e7781;
    --syn-function: #8250df;
    --syn-definition: #953800;
    border: 1px solid var(--hair);
    border-radius: 10px;
    margin: 1.5rem 0;
    background: var(--bg);
    color: var(--fg);
    overflow: hidden;
    font-family: var(--font-sans);
  }

  @media (prefers-color-scheme: dark) {
    .coderunner-cell {
      --syn-keyword: #ff7b72;
      --syn-string: #a5d6ff;
      --syn-number: #79c0ff;
      --syn-comment: #8b949e;
      --syn-function: #d2a8ff;
      --syn-definition: #ffa657;
    }
  }

  /* Hint = author-supplied caption, sits above the editor as a clear
     section title. Visual weight comparable to a small heading. */
  .coderunner-cell .cell-hint {
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 500;
    border-bottom: 1px solid var(--hair);
  }

  .coderunner-cell .editor-wrap {
    position: relative;
  }

  /* Footer overlays editor's bottom-right corner; absolute so it
     doesn't add a row of whitespace below the code. */
  .coderunner-cell .cell-footer {
    position: absolute;
    bottom: 2px;
    right: 6px;
    padding: 0 4px;
    font-size: 11px;
    background: var(--bg);
    border-radius: 3px;
    pointer-events: none;
    opacity: 0.35;
    transition: opacity 0.2s ease;
  }

  .coderunner-cell:hover .cell-footer,
  .coderunner-cell:focus-within .cell-footer {
    opacity: 1;
  }

  .coderunner-cell .cell-status {
    color: var(--mute);
    font-family: var(--font-mono);
  }

  .coderunner-cell .cell-status[data-state='running'] {
    color: var(--warn);
  }

  .coderunner-cell .cell-status[data-state='error'] {
    color: var(--err);
  }

  .coderunner-cell .output-container {
    padding: 12px;
    border-top: 1px solid var(--hair);
    font-size: 13px;
  }

  .coderunner-cell .output-container.hidden {
    display: none;
  }

  .coderunner-cell .coderunner-stdout,
  .coderunner-cell .coderunner-stderr,
  .coderunner-cell .coderunner-value,
  .coderunner-cell .coderunner-error {
    margin: 0 0 8px;
    padding: 8px 10px;
    border-radius: 4px;
    background: var(--hover);
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .coderunner-cell .coderunner-stderr {
    color: var(--warn);
  }

  .coderunner-cell .coderunner-value {
    border-left: 3px solid var(--ok);
  }

  .coderunner-cell .coderunner-error {
    color: var(--err);
    border-left: 3px solid var(--err);
  }

  .coderunner-cell .coderunner-image {
    margin: 0 0 8px;
    text-align: center;
  }

  .coderunner-cell .coderunner-image img {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .coderunner-cell .coderunner-html {
    margin: 0 0 8px;
    overflow-x: auto;
  }

  .coderunner-cell table.coderunner-df {
    border-collapse: collapse;
    font-size: 12px;
  }

  .coderunner-cell table.coderunner-df th,
  .coderunner-cell table.coderunner-df td {
    border: 1px solid var(--hair);
    padding: 4px 8px;
  }

  .coderunner-cell table.coderunner-df th {
    background: var(--hover);
    font-weight: 600;
  }

  .coderunner-cell .coderunner-status {
    padding: 6px 10px;
    border-radius: 4px;
    background: var(--hover);
    font-size: 12px;
  }

  .coderunner-cell .coderunner-status--info {
    color: var(--mute);
  }

  .coderunner-cell .coderunner-status--error {
    color: var(--err);
  }
</style>
